# ZeroDev Configuration
# Copy this file to .env and fill in your values

# Your ZeroDev Project ID (required)
# Get this from: https://dashboard.zerodev.app
ZERODEV_PROJECT_ID=your-project-id-here

# Your ZeroDev API Key (required - use either API Key or Team API Key, both are not needed)
# Get this from: https://dashboard.zerodev.app
USEROP_BUILDER_API_KEY=your-api-key-here

# Your ZeroDev Team API Key (optional - alternative to regular API Key)
# Use this for team-level authentication instead of USEROP_BUILDER_API_KEY
# Get this from: https://dashboard.zerodev.app
USEROP_BUILDER_TEAM_API_KEY=your-team-api-key-here
